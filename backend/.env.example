# AI Caller Backend Configuration Example
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadsense
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Voice Agent - Vapi (Recommended for natural conversational outbound calls)
VAPI_API_KEY=your-vapi-private-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# AI Voice Agent - Bolna (bolna-ai/bolna - Multilingual Indian Voice)
BOLNA_API_KEY=your-bolna-api-key-here
BOLNA_AGENT_ID=your-bolna-agent-id-here
BOLNA_SERVER_URL=https://api.bolna.dev

# AI LLM Capabilities (Groq Llama 3.3 or OpenAI; fallback mock used if empty)
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Telephony - Twilio (Alternative Telephony & SMS Alerts)
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-token-here
TWILIO_PHONE_NUMBER=your-twilio-number-here

# Telephony - Exotel (For Indian Numbers)
EXOTEL_ACCOUNT_SID=your-exotel-sid-here
EXOTEL_API_KEY=your-exotel-key-here
EXOTEL_API_TOKEN=your-exotel-token-here
EXOTEL_VIRTUAL_NUMBER=your-exotel-virtual-number-here

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Campaign dialer settings
# Public URL used for Twilio/Exotel webhooks (required in production)
PUBLIC_URL=https://your-public-domain.com/
# Max simultaneous outbound calls per campaign run (default: 10)
MAX_CONCURRENT_CALLS=10
# Set to true to bypass Indian business-hours compliance check during testing
BYPASS_COMPLIANCE=false
# Set to true to use WebSocket media streams instead of TwiML polling
USE_WEBSOCKETS=false

# SMTP Email Alerts (for hot lead notifications to Sales Manager)
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# Outlook/Office365: use smtp.office365.com, port 587
# Any SMTP provider works — just fill in host, port, user, password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=your-sender@gmail.com
